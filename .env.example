# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RPC_FALLBACK_URLS: Optional comma-separated list of secondary Solana RPC URLs for failover
RPC_FALLBACK_URLS=

# LIVE_API_KEY: Live Streaming API Key
LIVE_API_KEY=

# PRIMARY_RPC_URL & SECONDARY_RPC_URL
PRIMARY_RPC_URL=
SECONDARY_RPC_URL=

# LaserStream dual endpoints and keys
PRIMARY_LASERSTREAM_ENDPOINT=
PRIMARY_LASERSTREAM_API_KEY=
SECONDARY_LASERSTREAM_ENDPOINT=
SECONDARY_LASERSTREAM_API_KEY=

# Solana WSS URL
SOLANA_WSS_URL=

# PAPER_API_KEY: Paper Trading API Key (isolated from Live)
PAPER_API_KEY=

# JUPITER_API_KEY: Jupiter API Key (starts with JUB)
JUPITER_API_KEY=
